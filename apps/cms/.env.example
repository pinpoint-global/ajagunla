# Server (config/server.ts)
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Required secrets — sample values for local dev only; generate new ones for production/staging
# (e.g. openssl rand -base64 32  and  openssl rand -hex 16  for APP_KEYS entries)
APP_KEYS=7976b1304bd65c8da63bd332f3783801,d5f411f94ccba30893489f2956e96b63
API_TOKEN_SALT=dV9B7YObIwKAKIa4A7gwdY0M+cimrJI3MyDYUy6Z408=
ADMIN_JWT_SECRET=clqDFZD9bjwqwnVW/dp6h8vfATCPc+CedW+A/gDz+zM=
TRANSFER_TOKEN_SALT=opZvI1i9iLQqap8zz6ytRb+1U8xjuZpWQOMhaBHlE+c=
ENCRYPTION_KEY=IVcVmhttH5Qv5Gj2rJ/vfz5x/xFB6O3cPjcaLvJzQ0Q=
# Users & Permissions plugin (JWT for authenticated API users)
JWT_SECRET=LbUTTOt4Vhc2wOW5Te6+p7m9vy9jffIII0jw9l1Ys/Y=

# i18n default locale (config/plugins.ts)
STRAPI_DEFAULT_LOCALE=en

# Bootstrap seed (src/seed/run.ts): site-global, page singles, legislative projects, community initiatives.
STRAPI_SEED=false
# If true, delete existing seeded documents before inserting. Use for local resets only.
STRAPI_SEED_RESET=false

# --- Cloudflare R2 (S3-compatible uploads) — config/plugins.ts, config/middlewares.ts
# Omit or leave R2_UPLOAD_ENABLED unset to use Strapi’s default local file uploads.
# R2_UPLOAD_ENABLED=true
# R2_ACCESS_KEY_ID=
# R2_ACCESS_SECRET=
# R2_BUCKET=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_REGION=auto
# Public base URL for media (custom domain, public bucket URL, or *.r2.dev — not the S3 API endpoint).
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# Optional prefix inside the bucket for all Strapi uploads.
# R2_ROOT_PATH=

# Database (config/database.ts)
# Local dev: SQLite (default)
DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# Production: PostgreSQL — set DATABASE_CLIENT=postgres and connection details
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SCHEMA=public
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000
# Optional SSL file paths when DATABASE_SSL=true:
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=

# Production: MySQL — set DATABASE_CLIENT=mysql and same host/port/name/user/password pattern (port default 3306)

# Optional admin UI flags (config/admin.ts)
# FLAG_NPS=true
# FLAG_PROMOTE_EE=true
