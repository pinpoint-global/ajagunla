{
  "kind": "singleType",
  "collectionName": "page_abouts",
  "info": {
    "singularName": "page-about",
    "pluralName": "page-abouts",
    "displayName": "About page",
    "description": "About page content"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "biographyTexts": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-line"
    },
    "education": {
      "type": "component",
      "repeatable": true,
      "component": "about.education-entry"
    },
    "businesses": {
      "type": "component",
      "repeatable": true,
      "component": "about.business"
    },
    "awards": {
      "type": "component",
      "repeatable": true,
      "component": "about.award"
    },
    "senateCommittees": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.portfolio-card"
    },
    "legislativeImpact": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.impact-row"
    },
    "aboutPreviewHighlights": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-line"
    },
    "seo_metaTitle": { "type": "string" },
    "seo_metaDescription": { "type": "text" },
    "seo_keywords": {
      "type": "component",
      "repeatable": true,
      "component": "seo.keyword"
    },
    "seo_canonicalUrl": { "type": "string" },
    "seo_robots": {
      "type": "enumeration",
      "enum": ["index_follow", "noindex_nofollow", "noindex_follow", "index_nofollow"],
      "default": "index_follow"
    },
    "seo_ogType": {
      "type": "enumeration",
      "enum": ["website", "article"],
      "default": "website"
    },
    "seo_ogTitle": { "type": "string" },
    "seo_ogDescription": { "type": "text" },
    "seo_ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "seo_twitterCard": {
      "type": "enumeration",
      "enum": ["summary", "summary_large_image"],
      "default": "summary_large_image"
    },
    "seo_structuredData": { "type": "json" }
  }
}
