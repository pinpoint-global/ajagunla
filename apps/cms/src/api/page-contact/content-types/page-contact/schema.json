{
  "kind": "singleType",
  "collectionName": "page_contacts",
  "info": {
    "singularName": "page-contact",
    "pluralName": "page-contacts",
    "displayName": "Contact page",
    "description": "Contact page hero and cards"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heroTitle": { "type": "string" },
    "heroSubtitle": { "type": "text" },
    "contactCards": {
      "type": "component",
      "repeatable": true,
      "component": "contact.card"
    },
    "seo_metaTitle": { "type": "string" },
    "seo_metaDescription": { "type": "text" },
    "seo_keywords": {
      "type": "component",
      "repeatable": true,
      "component": "seo.keyword"
    },
    "seo_canonicalUrl": { "type": "string" },
    "seo_robots": {
      "type": "enumeration",
      "enum": ["index_follow", "noindex_nofollow", "noindex_follow", "index_nofollow"],
      "default": "index_follow"
    },
    "seo_ogType": {
      "type": "enumeration",
      "enum": ["website", "article"],
      "default": "website"
    },
    "seo_ogTitle": { "type": "string" },
    "seo_ogDescription": { "type": "text" },
    "seo_ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "seo_twitterCard": {
      "type": "enumeration",
      "enum": ["summary", "summary_large_image"],
      "default": "summary_large_image"
    },
    "seo_structuredData": { "type": "json" }
  }
}
