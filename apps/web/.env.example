# Web (apps/web) — copy to apps/web/.env.local
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
# Optional: Strapi API token if Public role is not used for read access
STRAPI_API_TOKEN=
# Required for creating records from web server routes (e.g. contact submissions)
STRAPI_WRITE_API_TOKEN=
NEXT_PUBLIC_SITE_URL=https://ajagunla1.com
live_url=https://ajagunla1.com

# Dev-only: show CMS-vs-fallback badges in the UI
# Enable via `?cmsDebug=1` or by setting this env var to `true`.
NEXT_PUBLIC_CMS_DEBUG=false
