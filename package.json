{
  "name": "ajagunla-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev -w ajagunla-web",
    "dev:cms": "npm run dev -w ajagunla-cms",
    "build": "turbo run build",
    "build:web": "npm run build -w ajagunla-web",
    "build:cms": "npm run build -w ajagunla-cms",
    "start:web": "npm run start -w ajagunla-web",
    "lint": "npm run lint -w ajagunla-web",
    "lint:fix": "npm run lint:fix -w ajagunla-web",
    "format": "npm run format -w ajagunla-web",
    "format:check": "npm run format:check -w ajagunla-web",
    "checks": "npm run checks -w ajagunla-web",
    "generate:icons": "npm run generate:icons -w ajagunla-web",
    "turbo": "turbo"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "dependencies": {
    "24": "^0.0.0"
  }
}
